situation_panel = {
	blockoverride "situation_top_subheader_content" {}

	blockoverride "situation_panel_main_content" {
		vbox = {
			layoutpolicy_horizontal = expanding
			spacing = 8
			widget = {
				layoutpolicy_horizontal = expanding
				size = { 510 72 }
				using = bg_dark_paper_card
				using = bg_cabinet_card_frame
				text_multi = {
					margin = { 12 8 }
					size = { 486 56 }
					fontsize = 18
					autoresize = no
					multiline = yes
					text = "mrb13_offlimits_management_overview"
				}
			}
			vbox = {
				layoutpolicy_horizontal = expanding
				using = bg_dark_paper_card
				using = bg_cabinet_card_frame
				widget = {
					layoutpolicy_horizontal = expanding
					size = { 510 34 }
					using = bg_card_header_01_military
					text_single = { margin = { 10 7 } text = "mrb13_offlimits_management_controls" }
				}
				button_regular = {
					margin = { 12 8 }
					layoutpolicy_horizontal = expanding
					size = { -1 28 }
					enabled = yes
					text = "mrb13_offlimits_toggle_france"
					action_tooltip = {
						on_action = "[GetScriptedGui('mrb13_offlimits_toggle_france').Execute(GuiScope.SetRoot(SituationView.GetPlayer.MakeScope).End)]"
					}
				}
				button_regular = {
					margin = { 12 8 }
					layoutpolicy_horizontal = expanding
					size = { -1 28 }
					enabled = yes
